//QuotesManager.h
#pragma once

#include <QObject>
#include <QJsonArray>

class QuotesManager : public QObject {
    Q_OBJECT
    Q_PROPERTY(QString randomQuote READ randomQuote NOTIFY quoteChanged)
    Q_PROPERTY(QString randomAuthor READ randomAuthor NOTIFY quoteChanged)

public:
    explicit QuotesManager(const QString &filePath, QObject *parent = nullptr);

    QString randomQuote();
    QString randomAuthor();

signals:
    void quoteChanged();

private:
    QJsonArray m_quotes;
    int m_lastIndex = -1;
};


